BasicInfo:
    Title:          "Armagetron Advanced 3DS"
    CompanyCode:    "00"
    ProductCode:    "CTR-H-AARM"
    ContentType:    "Application"
    Logo:           "Nintendo"

TitleInfo:
    UniqueId:       $(APP_UNIQUE_ID)

RomFs:
    RootPath:       "$(DIR_ROMFS)"

SystemControlInfo:
    StackSize:      0x100000

Option:
    UseOnSD:          true
    FreeProductCode:  true
    EnableCrypt:      false
    EnableCompress:   false

AccessControlInfo:
    # Naming any service here replaces makerom's default list rather than
    # adding to it. The previous three entry list left the title without
    # access to srv:, APT:U, fs:USER, gsp::Gpu or hid:USER, so an installed
    # CIA could not even bring libctru up. This is the usual homebrew list.
    ServiceAccessControl:
        - "APT:U"
        - "ac:u"
        - "act:u"
        - "am:net"
        - "boss:U"
        - "cam:u"
        - "cecd:u"
        - "cfg:nor"
        - "cfg:u"
        - "csnd:SND"
        - "dlp:SRVR"
        - "dsp::DSP"
        - "frd:u"
        - "fs:USER"
        - "gsp::Gpu"
        - "gsp::Lcd"
        - "hid:USER"
        - "http:C"
        - "ir:USER"
        - "ir:rst"
        - "ir:u"
        - "ldr:ro"
        - "mic:u"
        - "ndm:u"
        - "news:u"
        - "nim:aoc"
        - "nwm::UDS"
        - "ptm:sysm"
        - "ptm:u"
        - "pxi:dev"
        - "soc:U"
        - "srv:pm"
        - "ssl:C"
        - "y2r:u"
